# Wave API credentials
# Never commit real secrets to GitHub.
WAVE_ACCESS_TOKEN=PASTE_YOUR_WAVE_ACCESS_TOKEN_HERE
WAVE_BUSINESS_ID=PASTE_YOUR_KENDIS_KITCHEN_BUSINESS_ID_HERE
WAVE_WEBHOOK_SECRET=PASTE_YOUR_WAVE_WEBHOOK_SECRET_HERE
