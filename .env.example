# Wave API credentials
# Never commit real secrets to GitHub.
WAVE_ACCESS_TOKEN=PASTE_YOUR_WAVE_ACCESS_TOKEN_HERE
WAVE_BUSINESS_ID=PASTE_YOUR_KENDIS_KITCHEN_BUSINESS_ID_HERE
WAVE_WEBHOOK_SECRET=PASTE_YOUR_WAVE_WEBHOOK_SECRET_HERE
WAVE_INCOME_ACCOUNT_ID=PASTE_YOUR_WAVE_INCOME_ACCOUNT_ID_HERE

# Admin dashboard
# Choose a strong password and set it only in Render Environment Variables.
ADMIN_PASSWORD=CHOOSE_A_STRONG_ADMIN_PASSWORD

# Customer email notifications (optional)
# Resend API key and a verified sender address/domain are required.
RESEND_API_KEY=PASTE_YOUR_RESEND_API_KEY_HERE
NOTIFICATION_FROM_EMAIL=Kendis Kitchen <orders@your-verified-domain.com>

# Customer SMS notifications (optional)
# Twilio account credentials and a Twilio-enabled sending number are required.
TWILIO_ACCOUNT_SID=PASTE_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=PASTE_YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_FROM_NUMBER=+15555555555

# Optional application settings
PUBLIC_URL=https://YOUR-RENDER-URL.onrender.com
PORT=10000
