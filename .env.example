# Admin dashboard
# Choose a strong password and set it only in Render Environment Variables.
ADMIN_PASSWORD=CHOOSE_A_STRONG_ADMIN_PASSWORD

# Optional application settings
PUBLIC_URL=https://YOUR-RENDER-URL.onrender.com
PORT=10000
